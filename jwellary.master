<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        ul
        {
            list-style-type: none;
            margin: 0;
            padding: 15px;
            font-size: 20px;
            background-color: Orange;
            transaction: all 700ms;
           
        }
        li
        {
            display: inline;
            margin: 10px;
            
        }
        li a
        {
            text-decoration: none;
            font-weight: 700;
        }
        
        
        .ppic
        {
            width: 200px;
            height: 200px;
            border-redius: 50px;
            transition:all 700ms;
        }
        .ppic:hover
        {
            width: 250px;
            height: 250px;
            transform: scale(1.3,1.3);
            trasssation: 1s transation;
        }
            </style>
</head >
